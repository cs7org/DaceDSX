[general]
rootDir=<repo-dir>
logDir=<repo-dir>/_data/logs/
simulatorLogFile=PyPSA.log
simulatorErrorLogFile=matsim_error.log
# Relative to this configuration file, not the launch directory.
resultsDirectory=../_data/results
# options: xlsx, csv
dataframeExportFiletype=xlsx 


#KAFKA
schemaRegistry=http://localhost:8081
kafkaBroker=localhost:9092
kafkaLogLevel=msg
#kafkaLogLevel=mock

#TOPIC_NAMES
channelOrchestration=orchestration.simulation
channelInteraction=interaction.simulation
channelProvision=provision.simulation

topicScenario=scenario
topicResult=result
topicResource=resource
topicSyncMsg=sync
topicStatusMsg=status
topicCtrlMsg=ctrl

#resourceDirectory=../../daceDS-main/MATSimWrapper/resource

#SUMO
defaultConf=resource/default/default.cfg
defaultTraffic=resource/default/no.plans.xml
exe=<repo-dir>/

outputDirectory=output
#sumoHost=127.0.0.1
#sumoPort=19234
#nativeProcessingString=native

#makro
topicMakro=makro

#coSim
coSimRespForAllTag=all
